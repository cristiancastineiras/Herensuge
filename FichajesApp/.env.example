# Copia este fichero a FichajesApp/.env (no se sube al repositorio) y rellena los secretos.

# Contraseña de la base de datos de Fichajes: openssl rand -base64 24
POSTGRES_PASSWORD=

# Secreto del cliente OIDC fichajes-app: lo muestra el portal de Herensuge al crearlo (paso 2 del README).
FICHAJES_CLIENT_SECRET=

# La misma VALKEY_PASSWORD de Docker/.env (la BFF de Fichajes usa el Valkey de Herensuge).
HERENSUGE_VALKEY_PASSWORD=

# Clave del key ring de la BFF de Fichajes, distinta de la del portal: openssl rand -base64 32
BFF_KEY_RING_KEY=

# Nombres públicos (por defecto, los de local).
HERENSUGE_ID_HOST=id.herensuge.localhost
FICHAJES_HOST=fichajes.herensuge.localhost
