<?xml version="1.0" encoding="utf-8"?>
<!-- Repository-scoped NuGet configuration: only nuget.org, independent of machine-level feeds. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
