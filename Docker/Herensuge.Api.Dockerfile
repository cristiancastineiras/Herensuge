# syntax=docker/dockerfile:1
# Herensuge.Api (IdP) + web de login. Build from the repository root:
#   docker build -f Docker/Herensuge.Api.Dockerfile -t herensuge-api .

# 1. Web de login (Src/Web/apps/login) → /web/apps/login/dist
FROM node:24-slim AS web
# Public URL of the portal for the "Ir al portal" button (empty = hidden).
ARG VITE_URL_PORTAL=""
ENV VITE_URL_PORTAL=${VITE_URL_PORTAL}
RUN npm install --global --no-fund --no-audit pnpm@10.32.1
WORKDIR /web
# Only the lockfile first: the package download layer is reused until a dependency changes.
COPY Src/Web/pnpm-lock.yaml Src/Web/pnpm-workspace.yaml Src/Web/.npmrc ./
RUN pnpm fetch
COPY Src/Web/ ./
RUN pnpm install --offline --frozen-lockfile && pnpm --filter login build

# 2. .NET (the OpenAPI contract is generated by local and CI builds, not here)
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY global.json nuget.config Directory.Build.props Directory.Packages.props ./
COPY Src/Common/ Src/Common/
COPY Src/Modules/ Src/Modules/
COPY Src/Hosts/Herensuge.Api/ Src/Hosts/Herensuge.Api/
RUN --mount=type=cache,id=nuget,target=/root/.nuget/packages \
    dotnet restore Src/Hosts/Herensuge.Api/Herensuge.Api.csproj
RUN --mount=type=cache,id=nuget,target=/root/.nuget/packages \
    dotnet publish Src/Hosts/Herensuge.Api/Herensuge.Api.csproj -c Release -o /app --no-restore /p:UseAppHost=false /p:OpenApiGenerateDocuments=false
# Writable folder for the OIDC signing/encryption certificates (mounted as a volume).
RUN mkdir -p /keys && chown 1654:1654 /keys

# Distroless Ubuntu image with ICU and time zones; runs as the non-root "app" user (UID 1654).
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled-extra AS runtime
WORKDIR /app
COPY --from=build /app .
COPY --from=web /web/apps/login/dist ./wwwroot
COPY --from=build --chown=1654:1654 /keys /keys
ENV ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_gcServer=1
EXPOSE 8080
USER 1654
ENTRYPOINT ["dotnet", "Herensuge.Api.dll"]
