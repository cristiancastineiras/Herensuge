# Copy to Docker/.env and change EVERY secret before starting the stack.
# Generate secrets with:  openssl rand -base64 32

# Staging allows the "Log" email/SMS provider (messages are written to the logs).
# Production refuses to start until a real email and SMS provider is configured.
HERENSUGE_ENVIRONMENT=Staging
HERENSUGE_VERSION=local

# Public host names. Local machine: id.herensuge.localhost / portal.herensuge.localhost (Caddy internal CA;
# browsers resolve *.localhost to 127.0.0.1). Server: real DNS names pointing to it (Let's Encrypt).
# Both hosts must share a registrable domain: it is the passkey RP ID and keeps them same-site.
# (Plain id.localhost / portal.localhost does not work: browsers treat "localhost" as a public suffix.)
HERENSUGE_ID_HOST=id.herensuge.localhost
HERENSUGE_PORTAL_HOST=portal.herensuge.localhost
# Registrable domain shared by both hosts (example.com for id.example.com + portal.example.com).
PASSKEYS_RP_ID=herensuge.localhost
ACME_EMAIL=admin@example.com

# Data at rest (32 random bytes in base64 each: openssl rand -base64 32). They never go into the database:
# back them up separately. Without DATA_ENCRYPTION_KEY the personal data cannot be read; without HASHING_KEY
# nobody can sign in with a password or be found by email.
DATA_ENCRYPTION_KEY=
HASHING_KEY=
BFF_KEY_RING_KEY=

POSTGRES_PASSWORD=change-me-postgres
VALKEY_PASSWORD=change-me-valkey
PORTAL_CLIENT_SECRET=change-me-portal-client-secret
OIDC_KEYS_PASSWORD=change-me-oidc-keys

# The user who verifies this email becomes platform administrator.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
EMAIL_FROM=Herensuge <no-reply@example.com>

# Optional: Google / Microsoft sign-in (leave empty to hide the buttons).
# Redirect URIs to register at the provider:
#   https://<HERENSUGE_ID_HOST>/api/v1/auth/external/google/callback
#   https://<HERENSUGE_ID_HOST>/api/v1/auth/external/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
