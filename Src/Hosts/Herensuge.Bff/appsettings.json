{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "OpenIddict": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Valkey": ""
  },
  "Herensuge": {
    "TrustForwardedHeaders": false
  },
  "Bff": {
    "Authority": "https://localhost:5001/",
    "BackchannelAddress": "",
    "ClientId": "herensuge-portal",
    "ClientSecret": "",
    "Scopes": [ "openid", "profile", "email", "offline_access", "herensuge.api" ],
    "SessionLifetime": "7.00:00:00"
  },
  "ReverseProxy": {
    "Routes": {
      "herensuge-api": {
        "ClusterId": "herensuge-api",
        "Match": { "Path": "/api/{**catch-all}" }
      }
    },
    "Clusters": {
      "herensuge-api": {
        "Destinations": {
          "primary": { "Address": "https://localhost:5001" }
        }
      }
    }
  },
  "DataProtection": {
    "CertificatePath": "",
    "CertificatePassword": ""
  },
  "Spa": {
    "DevServerUrl": ""
  }
}
