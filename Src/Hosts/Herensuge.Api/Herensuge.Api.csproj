<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="../../Modules/Identity/Herensuge.Modules.Identity.Infrastructure/Herensuge.Modules.Identity.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Identity/Herensuge.Modules.Identity.Presentation/Herensuge.Modules.Identity.Presentation.csproj" />
    <ProjectReference Include="../../Modules/Tenancy/Herensuge.Modules.Tenancy.Infrastructure/Herensuge.Modules.Tenancy.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Tenancy/Herensuge.Modules.Tenancy.Presentation/Herensuge.Modules.Tenancy.Presentation.csproj" />
    <ProjectReference Include="../../Modules/Oidc/Herensuge.Modules.Oidc.Infrastructure/Herensuge.Modules.Oidc.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Oidc/Herensuge.Modules.Oidc.Presentation/Herensuge.Modules.Oidc.Presentation.csproj" />
    <ProjectReference Include="../../Modules/Audit/Herensuge.Modules.Audit.Infrastructure/Herensuge.Modules.Audit.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Audit/Herensuge.Modules.Audit.Presentation/Herensuge.Modules.Audit.Presentation.csproj" />
    <ProjectReference Include="../../Modules/Notifications/Herensuge.Modules.Notifications.Infrastructure/Herensuge.Modules.Notifications.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Writes the OpenAPI contract on every build (Docs/API/Herensuge.Api.json); the web types are generated from it. -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>
  <PropertyGroup>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../../../Docs/API</OpenApiDocumentsDirectory>
  </PropertyGroup>
  <!-- The endpoints live in the module DLLs, which change without Herensuge.Api.dll changing: regenerate on every build. -->
  <Target Name="AlwaysRegenerateOpenApiDocuments" BeforeTargets="GenerateOpenApiDocuments">
    <Delete Files="$(BaseIntermediateOutputPath)$(MSBuildProjectName).OpenApiFiles.cache" />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="Herensuge.IntegrationTests" />
  </ItemGroup>
</Project>
