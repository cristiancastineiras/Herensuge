{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "OpenIddict": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "",
    "Valkey": ""
  },
  "Herensuge": {
    "TrustForwardedHeaders": false,
    "AllowedReturnOrigins": []
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Oidc": {
    "Issuer": "https://localhost:5001/",
    "Keys": {
      "Directory": "App_Data/oidc-keys",
      "Password": "",
      "AutoGenerate": true
    },
    "PortalClient": {
      "ClientId": "herensuge-portal",
      "ClientSecret": "",
      "RedirectUris": [ "https://localhost:5002/bff/callback" ],
      "PostLogoutRedirectUris": [ "https://localhost:5002/bff/signout-callback" ]
    }
  },
  "Identity": {
    "BootstrapPlatformAdminEmail": "",
    "Argon2": {
      "MemorySizeKiB": 19456,
      "Iterations": 2,
      "Parallelism": 1
    },
    "Totp": {
      "Issuer": "Herensuge"
    },
    "Passkeys": {
      "RelyingPartyId": "localhost",
      "RelyingPartyName": "Herensuge",
      "Origins": [ "https://localhost:5001", "https://localhost:5002" ]
    },
    "ExternalProviders": {
      "Google": { "ClientId": "", "ClientSecret": "" },
      "Microsoft": { "ClientId": "", "ClientSecret": "", "Tenant": "common" }
    }
  },
  "Notifications": {
    "PublicBaseUrl": "https://localhost:5001",
    "ProductName": "Herensuge",
    "Email": { "Provider": "Log", "From": "Herensuge <no-reply@herensuge.local>" },
    "Sms": { "Provider": "Log", "From": "Herensuge" }
  },
  "Messaging": {
    "PollingInterval": "00:00:01",
    "BatchSize": 20,
    "MaxAttempts": 10,
    "Retention": "7.00:00:00"
  },
  "Audit": {
    "RetentionDays": 365
  },
  "RateLimiting": {
    "StrictPermitLimit": 10,
    "PermitLimit": 60
  },
  "DataProtection": {
    "CertificatePath": "",
    "CertificatePassword": ""
  },
  "Spa": {
    "DevServerUrl": ""
  }
}
