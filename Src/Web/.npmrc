# Ningún paquete ejecuta scripts al instalarse (protección frente a ataques de supply chain).
# Las dependencias nativas (rolldown, lightningcss, tailwind, oxc) se instalan como optionalDependencies
# por plataforma, así que no necesitan postinstall.
ignore-scripts=true
strict-ssl=true
strict-peer-dependencies=false
link-workspace-packages=true
registry=https://registry.npmjs.org/
fetch-timeout=60000
loglevel=warn
