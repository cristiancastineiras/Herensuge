{
  "private": true,
  "name": "plantilla.monorepo",
  "version": "1.0.0",
  "description": "Plantilla de monorepo React optimizada para producción con Vite, Turbo y pnpm",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "paquetes/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:webapp": "turbo run build --filter=webapp",
    "preview": "turbo run preview",
    "lint": "turbo run lint",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run lint && pnpm run format:check",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules/.cache",
    "clean:all": "rimraf **/node_modules **/dist **/.turbo && pnpm install",
    "prepare": "echo 'Hooks de git listos'",
    "audit": "pnpm audit --audit-level=moderate",
    "deps:check": "pnpm outdated --recursive",
    "deps:update": "pnpm update --recursive --latest"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-table": "^9.2.4",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.0",
    "ky": "^2.1.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.1",
    "react-router-dom": "^7.16.0",
    "sonner": "^2.0.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/dotenv": "^8.2.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "dotenv-cli": "^11.0.0",
    "globals": "^17.13.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.30",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.14",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.1",
    "turbo": "^2.11.8",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.4.31": ">=8.4.31"
    }
  }
}
